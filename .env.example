# Hashes only. Generate with: python -m app.mkkey analyst   (roles: viewer, analyst, admin)
PRP_API_KEYS=<sha256hex>:analyst,<sha256hex>:viewer,<sha256hex>:admin
PRP_DB_PATH=prp.db
PRP_RATE_LIMIT=60
# Optional authorized reputation source (hostname-only lookups; leave unset to disable)
# PRP_INTEL_URL=https://intel.example.test/lookup
# PRP_INTEL_KEY=
